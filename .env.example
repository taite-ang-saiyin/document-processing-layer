# Application Settings
PROJECT_NAME="Burmese Insurance Claim Form OCR Backend"
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL)
POSTGRES_USER=ocr_user
POSTGRES_PASSWORD=ocr_password_secure
POSTGRES_DB=ocr_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ocr_user:ocr_password_secure@db:5432/ocr_db

# Model & Thresholds
DEVICE=cpu
BLUR_LAPLACIAN_THRESHOLD=100.0
CONFIDENCE_THRESHOLD=0.85
